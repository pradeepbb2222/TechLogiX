
# PayPal Sandbox credentials (server-side only)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_ENV=sandbox

# Order management
ORDER_EXPIRY_MINUTES=30
MAX_PENDING_ORDERS_PER_SESSION=3

# Application URL used for PayPal return/cancel URLs
APP_URL=http://localhost:3000

# Server-side spending cap in USD
AGENT_SPENDING_LIMIT=1000

# Supabase authentication (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase server-side persistence
# Required when using the Supabase transaction store
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Channel3 product discovery
CHANNEL3_API_KEY=

# Google Gemini AI
GOOGLE_GENERATIVE_AI_API_KEY=
