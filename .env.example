# Copy to .env.local (git-ignored). Server-side only: never prefix with NEXT_PUBLIC_.
# Use the credentials of the "AgentFlow" PayPal Sandbox REST app (NOT the Default Application).
# Paste values directly into .env.local yourself; never share the secret in chat or commit it.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_ENV=sandbox

# Optional
# Public origin used for PayPal return/cancel URLs (default http://localhost:3000)
APP_URL=http://localhost:3000
# Server-side spending cap in USD; the browser slider can only lower it (default 1000)
AGENT_SPENDING_LIMIT=1000

# Optional: persist transactions in Supabase/PostgreSQL (run supabase/schema.sql first).
# If unset, a local file store (.data/transactions.json) is used for development.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
